#!/bin/sh
# AppRun for anime-game-launcher AppImage with dependency checking

MISSING_DEPS=""

if ! command -v git >/dev/null 2>&1; then
    MISSING_DEPS="$MISSING_DEPS git"
fi

if ! command -v 7z >/dev/null 2>&1 && ! command -v 7zz >/dev/null 2>&1 && ! command -v 7za >/dev/null 2>&1; then
    MISSING_DEPS="$MISSING_DEPS p7zip"
fi

if [ -n "$MISSING_DEPS" ]; then
    MESSAGE="An Anime Game Launcher requires the following missing system dependencies to run properly:$MISSING_DEPS.\n\nPlease install them using your system package manager (e.g. sudo dnf install git p7zip or sudo pacman -S git p7zip) before launching."
    
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --text="$MESSAGE" --title="Missing Dependencies"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$MESSAGE" --title="Missing Dependencies"
    else
        echo "ERROR: $MESSAGE" >&2
    fi
    exit 1
fi

HERE="$(dirname "$(readlink -f "${0}")")"
exec "${HERE}/usr/bin/anime-game-launcher" "$@"
